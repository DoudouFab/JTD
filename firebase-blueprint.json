{
  "entities": {
    "PreauthorizedEmail": {
      "title": "PreauthorizedEmail",
      "description": "E-mail préautorisé par l'administrateur avec son code personnel d'activation.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "minLength": 3, "maxLength": 200 },
        "accessCode": { "type": "string", "minLength": 3, "maxLength": 32 },
        "note": { "type": "string", "maxLength": 250 },
        "createdBy": { "type": "string", "minLength": 3, "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "accessCode", "note", "createdBy", "createdAt"]
    },
    "AccessUser": {
      "title": "AccessUser",
      "description": "Fiche d'accès par appareil pour un collègue authentifié (pending, approved, revoked).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "minLength": 3, "maxLength": 200 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "status": { "type": "string", "enum": ["pending", "approved", "revoked"] },
        "deviceHint": { "type": "string", "maxLength": 120 },
        "note": { "type": "string", "maxLength": 250 },
        "activationCode": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "role",
        "status",
        "deviceHint",
        "note",
        "activationCode",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPublic": {
      "title": "UserPublic",
      "description": "Profil public et préférences d'un utilisateur autorisé (sans données PII).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "active": { "type": "boolean" },
        "defaultPrepose": { "type": "string", "maxLength": 150 },
        "defaultHoraireDebut": { "type": "string", "maxLength": 20 },
        "defaultHoraireFin": { "type": "string", "maxLength": 20 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "displayName",
        "role",
        "active",
        "defaultPrepose",
        "defaultHoraireDebut",
        "defaultHoraireFin",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Informations personnelles isolées de l'utilisateur (email).",
      "type": "object",
      "properties": {
        "email": { "type": "string", "minLength": 3, "maxLength": 200 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "updatedAt"]
    },
    "Chantier": {
      "title": "Chantier",
      "description": "Fiche de chantier INASEP strictement privée à son propriétaire, avec lecteurs temporaires autorisés par dossier.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ownerName": { "type": "string", "maxLength": 120 },
        "visibility": { "type": "string", "enum": ["private"] },
        "readerIds": { "type": "array" },
        "readerEmails": { "type": "array" },
        "numero": { "type": "string", "maxLength": 100 },
        "projet": { "type": "string", "maxLength": 250 },
        "entrepriseNom": { "type": "string", "maxLength": 200 },
        "entrepriseAdresse": { "type": "string", "maxLength": 500 },
        "references": { "type": "string", "maxLength": 150 },
        "adresseChantier": { "type": "string", "maxLength": 500 },
        "horaireDebut": { "type": "string", "maxLength": 20 },
        "horaireFin": { "type": "string", "maxLength": 20 },
        "preposeSurveillance": { "type": "string", "maxLength": 150 },
        "postes": { "type": "array" },
        "journalIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "ownerId",
        "ownerName",
        "visibility",
        "readerIds",
        "numero",
        "projet",
        "entrepriseNom",
        "entrepriseAdresse",
        "references",
        "adresseChantier",
        "horaireDebut",
        "horaireFin",
        "preposeSurveillance",
        "postes",
        "journalIds",
        "createdAt",
        "updatedAt"
      ]
    },
    "Journal": {
      "title": "Journal",
      "description": "Page journalière des travaux (en cours ou terminée) avec signatures cryptographiques Contrôleur et Lecteur.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "chantierId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "chantierOwnerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "chantierReaderIds": { "type": "array" },
        "chantierReaderEmails": { "type": "array" },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "enum": ["in_progress", "completed"] },
        "journalNum": { "type": "number" },
        "date": { "type": "string", "maxLength": 20 },
        "horaireDebut": { "type": "string", "maxLength": 20 },
        "horaireFin": { "type": "string", "maxLength": 20 },
        "tempMatin": { "type": "string", "maxLength": 20 },
        "tempApresMidi": { "type": "string", "maxLength": 20 },
        "etatAtmo": { "type": "array" },
        "ouvriers": { "type": "array" },
        "travaux": { "type": "array" },
        "materiel": { "type": "array" },
        "materiaux": { "type": "array" },
        "essais": { "type": "array" },
        "evenements": { "type": "array" },
        "decisions": { "type": "array" },
        "visites": { "type": "array" },
        "sigEntrepreneur": { "type": "string", "maxLength": 150 },
        "signatureControleur": { "type": "object" },
        "signatureLecteur": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "chantierId",
        "chantierOwnerId",
        "chantierReaderIds",
        "authorId",
        "authorName",
        "status",
        "journalNum",
        "date",
        "horaireDebut",
        "horaireFin",
        "tempMatin",
        "tempApresMidi",
        "etatAtmo",
        "ouvriers",
        "travaux",
        "materiel",
        "materiaux",
        "essais",
        "evenements",
        "decisions",
        "visites",
        "sigEntrepreneur",
        "signatureControleur",
        "signatureLecteur",
        "createdAt",
        "updatedAt"
      ]
    },
    "ShareInvite": {
      "title": "ShareInvite",
      "description": "Code d'invitation temporaire généré par le contrôleur pour un dossier précis.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 4, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "chantierId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "chantierNumero": { "type": "string", "maxLength": 100 },
        "chantierProjet": { "type": "string", "maxLength": 250 },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ownerName": { "type": "string", "maxLength": 120 },
        "label": { "type": "string", "maxLength": 150 },
        "active": { "type": "boolean" },
        "usedByUid": { "type": "string", "maxLength": 128 },
        "expiresAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "code",
        "chantierId",
        "chantierNumero",
        "chantierProjet",
        "ownerId",
        "ownerName",
        "label",
        "active",
        "usedByUid",
        "expiresAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChantierShare": {
      "title": "ChantierShare",
      "description": "Accès temporaire en lecture (et signature lecteur) lié à un chantier précis.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 3, "maxLength": 260, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "chantierId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "chantierOwnerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "inviteCode": { "type": "string", "minLength": 4, "maxLength": 64 },
        "readerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "readerName": { "type": "string", "maxLength": 120 },
        "label": { "type": "string", "maxLength": 150 },
        "revoked": { "type": "boolean" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "chantierId",
        "chantierOwnerId",
        "inviteCode",
        "readerUid",
        "readerName",
        "label",
        "revoked",
        "expiresAt",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/preauthorized_emails/{emailId}": {
      "schema": { "$ref": "#/entities/PreauthorizedEmail" },
      "description": "E-mails préautorisés avec code personnel créés exclusivement par l'administrateur."
    },
    "/access_users/{userId}": {
      "schema": { "$ref": "#/entities/AccessUser" },
      "description": "Statut d'accès par appareil pour les collègues (pending, approved, revoked)."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublic" },
      "description": "Profil public de l'utilisateur (nom, rôle, statut d'approbation admin, préférences)."
    },
    "/users/{userId}/private/info": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Données privées PII de l'utilisateur (adresse email)."
    },
    "/chantiers/{chantierId}": {
      "schema": { "$ref": "#/entities/Chantier" },
      "description": "Chantiers strictement privés à leur contrôleur propriétaire (+ lecteurs temporaires actifs)."
    },
    "/chantiers/{chantierId}/journaux/{journalId}": {
      "schema": { "$ref": "#/entities/Journal" },
      "description": "Journaux quotidiens d'un chantier avec statut et signatures d'authentification."
    },
    "/shareInvites/{inviteCode}": {
      "schema": { "$ref": "#/entities/ShareInvite" },
      "description": "Invitations temporaires liées à un dossier précis."
    },
    "/chantierShares/{shareId}": {
      "schema": { "$ref": "#/entities/ChantierShare" },
      "description": "Droits d'accès temporaires en lecture et signature pour un dossier précis."
    }
  }
}
