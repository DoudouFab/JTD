rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn()
        && request.auth.token.email is string
        && (request.auth.token.email_verified == true
            || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    // Sole Administrator (Fabien Pirquin: Gmail or INASEP verified)
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && (request.auth.token.email.lower() == 'pirquinfabien@gmail.com'
            || request.auth.token.email.lower() == 'fabien.pirquin@inasep.be');
    }

    function normalizeEmailId(email) {
      return email.lower().replace('[^a-z0-9\\-]', '_');
    }

    function isVerifiedActive() {
      return isVerifiedUser() && (
        isAdmin()
        || (exists(/databases/$(database)/documents/access_users/$(request.auth.uid))
            && get(/databases/$(database)/documents/access_users/$(request.auth.uid)).data.status == 'approved')
      );
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailId(id) {
      return id is string && id.size() >= 1 && id.size() <= 200 && id.matches('^[a-z0-9_\\-]+$');
    }

    function isValidShareDocId(id) {
      return id is string && id.size() >= 3 && id.size() <= 260 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isStringBounded(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isStringListBounded(val, maxItems) {
      return val is list && val.size() <= maxItems && (val.size() == 0 || val[0] is string);
    }

    function isValidPreauthorizedEmail(data) {
      return data.keys().hasAll([
        'id', 'email', 'accessCode', 'note', 'createdBy', 'createdAt'
      ])
      && data.keys().hasOnly([
        'id', 'email', 'accessCode', 'note', 'createdBy', 'createdAt'
      ])
      && isValidEmailId(data.id)
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
      && data.accessCode is string && data.accessCode.size() >= 3 && data.accessCode.size() <= 32
      && isStringBounded(data.note, 250)
      && data.createdBy is string && data.createdBy.size() >= 3 && data.createdBy.size() <= 200
      && data.createdAt is timestamp;
    }

    function isValidAccessUser(data) {
      return data.keys().hasAll([
        'uid', 'email', 'displayName', 'role', 'status',
        'deviceHint', 'note', 'activationCode', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'email', 'displayName', 'role', 'status',
        'deviceHint', 'note', 'activationCode', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.uid)
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
      && data.role in ['admin', 'user']
      && data.status in ['pending', 'approved', 'revoked']
      && isStringBounded(data.deviceHint, 120)
      && isStringBounded(data.note, 250)
      && isStringBounded(data.activationCode, 32)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidSignatureRecord(sig, expectedRole) {
      return sig == null || (
        sig is map
        && sig.keys().hasAll([
          'role', 'method', 'signerUid', 'signerName', 'signerEmail',
          'nationalIdHash', 'verificationId', 'verifiedAt', 'signedAt',
          'documentSha256', 'cryptoDigest', 'webAuthnUsed'
        ])
        && sig.keys().hasOnly([
          'role', 'method', 'signerUid', 'signerName', 'signerEmail',
          'nationalIdHash', 'verificationId', 'verifiedAt', 'signedAt',
          'documentSha256', 'cryptoDigest', 'webAuthnUsed'
        ])
        && sig.role == expectedRole
        && sig.method in ['itsme', 'eid']
        && isValidId(sig.signerUid)
        && sig.signerName is string && sig.signerName.size() >= 1 && sig.signerName.size() <= 120
        && isStringBounded(sig.signerEmail, 200)
        && isStringBounded(sig.nationalIdHash, 128)
        && sig.verificationId is string && sig.verificationId.size() >= 4 && sig.verificationId.size() <= 80
        && sig.verifiedAt is string && sig.verifiedAt.size() >= 10 && sig.verifiedAt.size() <= 40
        && sig.signedAt is string && sig.signedAt.size() >= 10 && sig.signedAt.size() <= 40
        && sig.documentSha256 is string && sig.documentSha256.size() >= 32 && sig.documentSha256.size() <= 128
        && sig.cryptoDigest is string && sig.cryptoDigest.size() >= 16 && sig.cryptoDigest.size() <= 512
        && sig.webAuthnUsed is bool
      );
    }

    function isValidUserPublic(data) {
      return data.keys().hasAll([
        'uid', 'displayName', 'role', 'active',
        'defaultPrepose', 'defaultHoraireDebut', 'defaultHoraireFin',
        'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'displayName', 'role', 'active',
        'defaultPrepose', 'defaultHoraireDebut', 'defaultHoraireFin',
        'createdAt', 'updatedAt'
      ])
      && isValidId(data.uid)
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
      && data.role in ['admin', 'user']
      && data.active is bool
      && isStringBounded(data.defaultPrepose, 150)
      && isStringBounded(data.defaultHoraireDebut, 20)
      && isStringBounded(data.defaultHoraireFin, 20)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidUserPrivate(data) {
      return data.keys().hasAll(['email', 'updatedAt'])
        && data.keys().hasOnly(['email', 'updatedAt'])
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.updatedAt is timestamp;
    }

    function isValidChantier(data) {
      return data.keys().hasAll([
        'id', 'ownerId', 'ownerName', 'visibility', 'readerIds',
        'numero', 'projet', 'entrepriseNom', 'entrepriseAdresse',
        'references', 'adresseChantier', 'horaireDebut', 'horaireFin',
        'preposeSurveillance', 'postes', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'ownerId', 'ownerName', 'visibility', 'readerIds',
        'numero', 'projet', 'entrepriseNom', 'entrepriseAdresse',
        'references', 'adresseChantier', 'horaireDebut', 'horaireFin',
        'preposeSurveillance', 'postes', 'journalIds', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && isValidId(data.ownerId)
      && isStringBounded(data.ownerName, 120)
      && data.visibility == 'private'
      && isStringListBounded(data.readerIds, 25)
      && (!('journalIds' in data) || isStringListBounded(data.journalIds, 1000))
      && isStringBounded(data.numero, 100)
      && isStringBounded(data.projet, 250)
      && isStringBounded(data.entrepriseNom, 200)
      && isStringBounded(data.entrepriseAdresse, 500)
      && isStringBounded(data.references, 150)
      && isStringBounded(data.adresseChantier, 500)
      && isStringBounded(data.horaireDebut, 20)
      && isStringBounded(data.horaireFin, 20)
      && isStringBounded(data.preposeSurveillance, 150)
      && isStringListBounded(data.postes, 2000)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidJournal(data) {
      return data.keys().hasAll([
        'id', 'chantierId', 'chantierOwnerId', 'chantierReaderIds',
        'authorId', 'authorName', 'status', 'journalNum',
        'date', 'horaireDebut', 'horaireFin', 'tempMatin', 'tempApresMidi',
        'etatAtmo', 'ouvriers', 'travaux', 'materiel', 'materiaux',
        'essais', 'evenements', 'decisions', 'visites', 'sigEntrepreneur',
        'signatureControleur', 'signatureLecteur', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'chantierId', 'chantierOwnerId', 'chantierReaderIds',
        'authorId', 'authorName', 'status', 'journalNum',
        'date', 'horaireDebut', 'horaireFin', 'tempMatin', 'tempApresMidi',
        'etatAtmo', 'ouvriers', 'travaux', 'materiel', 'materiaux',
        'essais', 'evenements', 'decisions', 'visites', 'sigEntrepreneur',
        'signatureControleur', 'signatureLecteur', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && isValidId(data.chantierId)
      && isValidId(data.chantierOwnerId)
      && isStringListBounded(data.chantierReaderIds, 25)
      && isValidId(data.authorId)
      && isStringBounded(data.authorName, 120)
      && data.status in ['in_progress', 'completed']
      && data.journalNum is number && data.journalNum >= 1 && data.journalNum <= 99999
      && isStringBounded(data.date, 20)
      && isStringBounded(data.horaireDebut, 20)
      && isStringBounded(data.horaireFin, 20)
      && isStringBounded(data.tempMatin, 20)
      && isStringBounded(data.tempApresMidi, 20)
      && isStringListBounded(data.etatAtmo, 20)
      && data.ouvriers is list && data.ouvriers.size() <= 100 && (data.ouvriers.size() == 0 || data.ouvriers[0] is map)
      && isStringListBounded(data.travaux, 200)
      && isStringListBounded(data.materiel, 200)
      && isStringListBounded(data.materiaux, 200)
      && isStringListBounded(data.essais, 200)
      && isStringListBounded(data.evenements, 200)
      && isStringListBounded(data.decisions, 200)
      && isStringListBounded(data.visites, 200)
      && isStringBounded(data.sigEntrepreneur, 150)
      && isValidSignatureRecord(data.signatureControleur, 'controleur')
      && isValidSignatureRecord(data.signatureLecteur, 'lecteur')
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidShareInvite(data) {
      return data.keys().hasAll([
        'code', 'chantierId', 'chantierNumero', 'chantierProjet',
        'ownerId', 'ownerName', 'label', 'active', 'usedByUid',
        'expiresAt', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'code', 'chantierId', 'chantierNumero', 'chantierProjet',
        'ownerId', 'ownerName', 'label', 'active', 'usedByUid',
        'expiresAt', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.code)
      && isValidId(data.chantierId)
      && isStringBounded(data.chantierNumero, 100)
      && isStringBounded(data.chantierProjet, 250)
      && isValidId(data.ownerId)
      && isStringBounded(data.ownerName, 120)
      && isStringBounded(data.label, 150)
      && data.active is bool
      && isStringBounded(data.usedByUid, 128)
      && data.expiresAt is timestamp
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidChantierShare(data) {
      return data.keys().hasAll([
        'id', 'chantierId', 'chantierOwnerId', 'inviteCode',
        'readerUid', 'readerName', 'label', 'revoked',
        'expiresAt', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'chantierId', 'chantierOwnerId', 'inviteCode',
        'readerUid', 'readerName', 'label', 'revoked',
        'expiresAt', 'createdAt', 'updatedAt'
      ])
      && isValidShareDocId(data.id)
      && isValidId(data.chantierId)
      && isValidId(data.chantierOwnerId)
      && isValidId(data.inviteCode)
      && isValidId(data.readerUid)
      && isStringBounded(data.readerName, 120)
      && isStringBounded(data.label, 150)
      && data.revoked is bool
      && data.expiresAt is timestamp
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function hasActiveShare(chantierId) {
      return exists(/databases/$(database)/documents/chantierShares/$(chantierId + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/chantierShares/$(chantierId + '_' + request.auth.uid)).data.revoked == false
        && get(/databases/$(database)/documents/chantierShares/$(chantierId + '_' + request.auth.uid)).data.expiresAt > request.time;
    }

    // -------------------------------------------------------------------------
    // 1. Preauthorized Emails & Personal Activation Codes
    // -------------------------------------------------------------------------
    match /preauthorized_emails/{emailId} {
      allow get: if isVerifiedUser()
        && isValidEmailId(emailId)
        && (isAdmin() || emailId == normalizeEmailId(request.auth.token.email));

      allow list: if isAdmin();

      allow create: if isAdmin()
        && isValidEmailId(emailId)
        && isValidPreauthorizedEmail(incoming())
        && incoming().id == emailId
        && normalizeEmailId(incoming().email) == emailId
        && incoming().createdBy == request.auth.token.email
        && incoming().createdAt == request.time;

      allow update: if isAdmin()
        && isValidEmailId(emailId)
        && isValidPreauthorizedEmail(incoming())
        && incoming().id == existing().id
        && incoming().email == existing().email
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['accessCode', 'note']);

      allow delete: if isAdmin() && isValidEmailId(emailId);
    }

    // -------------------------------------------------------------------------
    // 2. Per-Device Access Control (access_users/{userId})
    // -------------------------------------------------------------------------
    match /access_users/{userId} {
      allow get: if isVerifiedUser()
        && isValidId(userId)
        && (isAdmin() || userId == request.auth.uid);

      allow list: if isAdmin();

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isValidAccessUser(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (userId == request.auth.uid
              && incoming().role == 'user'
              && incoming().email.lower() == request.auth.token.email.lower()
              && (
                (incoming().status == 'pending' && incoming().activationCode == '')
                || (incoming().status == 'approved'
                    && incoming().activationCode.size() >= 3
                    && exists(/databases/$(database)/documents/preauthorized_emails/$(normalizeEmailId(request.auth.token.email)))
                    && incoming().activationCode.lower() == get(/databases/$(database)/documents/preauthorized_emails/$(normalizeEmailId(request.auth.token.email))).data.accessCode.lower())
              ))
        );

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidAccessUser(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Admin can approve, revoke, edit note/code
          (isAdmin()
            && incoming().role in ['admin', 'user']
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'note', 'activationCode', 'displayName', 'deviceHint', 'email', 'updatedAt'
            ]))
          // Colleague already approved: metadata sync only (never self-promote role or alter status)
          || (userId == request.auth.uid
              && existing().status == 'approved'
              && incoming().status == 'approved'
              && incoming().role == existing().role
              && incoming().role == 'user'
              && incoming().email.lower() == request.auth.token.email.lower()
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'displayName', 'deviceHint', 'email', 'updatedAt'
              ]))
          // Colleague activating from 'pending' using valid personal code (blocked if existing().status == 'revoked')
          || (userId == request.auth.uid
              && existing().status == 'pending'
              && incoming().status == 'approved'
              && incoming().role == 'user'
              && incoming().email.lower() == request.auth.token.email.lower()
              && incoming().activationCode.size() >= 3
              && exists(/databases/$(database)/documents/preauthorized_emails/$(normalizeEmailId(request.auth.token.email)))
              && incoming().activationCode.lower() == get(/databases/$(database)/documents/preauthorized_emails/$(normalizeEmailId(request.auth.token.email))).data.accessCode.lower()
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'activationCode', 'displayName', 'deviceHint', 'note', 'email', 'updatedAt'
              ]))
          // Colleague remaining pending: device hint sync
          || (userId == request.auth.uid
              && existing().status == 'pending'
              && incoming().status == 'pending'
              && incoming().role == 'user'
              && incoming().email.lower() == request.auth.token.email.lower()
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'displayName', 'deviceHint', 'email', 'updatedAt'
              ]))
        );

      allow delete: if isAdmin() && isValidId(userId) && userId != request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // 3. User Preferences (users/{userId})
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && (isAdmin() || userId == request.auth.uid);
      allow list: if isAdmin() || (isVerifiedUser() && resource.data.uid == request.auth.uid);

      allow create: if isVerifiedActive()
        && isValidId(userId)
        && isValidUserPublic(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && userId == request.auth.uid && incoming().role == 'admin' && incoming().active == true)
          || (userId == request.auth.uid && incoming().role == 'user' && incoming().active == true)
        );

      allow update: if isVerifiedActive()
        && isValidId(userId)
        && isValidUserPublic(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().role == existing().role
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (isOwner(userId)
              && incoming().active == existing().active
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'displayName', 'defaultPrepose', 'defaultHoraireDebut', 'defaultHoraireFin', 'updatedAt'
              ]))
        );

      allow delete: if isAdmin() && isValidId(userId) && userId != request.auth.uid;

      match /private/{docId} {
        allow get: if isValidId(userId) && docId == 'info' && (isOwner(userId) || isAdmin());
        allow list: if isAdmin() || (isVerifiedUser() && userId == request.auth.uid);

        allow create: if isValidId(userId)
          && docId == 'info'
          && (isOwner(userId) || isAdmin())
          && isValidUserPrivate(incoming())
          && incoming().updatedAt == request.time;

        allow update: if isValidId(userId)
          && docId == 'info'
          && (isOwner(userId) || isAdmin())
          && isValidUserPrivate(incoming())
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);

        allow delete: if isAdmin() && isValidId(userId) && docId == 'info';
      }
    }

    // -------------------------------------------------------------------------
    // 4. Temporary Share Invites & Grants
    // -------------------------------------------------------------------------
    match /shareInvites/{inviteCode} {
      allow get: if isVerifiedActive() && isValidId(inviteCode);
      allow list: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;

      allow create: if isVerifiedActive()
        && isValidId(inviteCode)
        && isValidShareInvite(incoming())
        && incoming().code == inviteCode
        && incoming().ownerId == request.auth.uid
        && incoming().active == true
        && incoming().usedByUid == ''
        && incoming().expiresAt > request.time
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/chantiers/$(incoming().chantierId))
        && get(/databases/$(database)/documents/chantiers/$(incoming().chantierId)).data.ownerId == request.auth.uid;

      allow update: if isVerifiedActive()
        && isValidId(inviteCode)
        && isValidShareInvite(incoming())
        && incoming().code == existing().code
        && incoming().chantierId == existing().chantierId
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (existing().ownerId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['active', 'expiresAt', 'label', 'updatedAt']))
          || (existing().active == true
              && existing().expiresAt > request.time
              && (existing().usedByUid == '' || existing().usedByUid == request.auth.uid)
              && incoming().usedByUid == request.auth.uid
              && incoming().diff(existing()).affectedKeys().hasOnly(['usedByUid', 'updatedAt']))
        );

      allow delete: if isVerifiedActive() && isValidId(inviteCode) && existing().ownerId == request.auth.uid;
    }

    match /chantierShares/{shareId} {
      allow get: if isVerifiedActive()
        && isValidShareDocId(shareId)
        && ((resource == null && shareId.matches('^.+_' + request.auth.uid + '$'))
            || (resource != null && (existing().chantierOwnerId == request.auth.uid || existing().readerUid == request.auth.uid)));

      allow list: if isVerifiedUser()
        && (resource.data.chantierOwnerId == request.auth.uid || resource.data.readerUid == request.auth.uid);

      allow create: if isVerifiedActive()
        && isValidShareDocId(shareId)
        && isValidChantierShare(incoming())
        && shareId == (incoming().chantierId + '_' + request.auth.uid)
        && incoming().readerUid == request.auth.uid
        && incoming().revoked == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/shareInvites/$(incoming().inviteCode))
        && get(/databases/$(database)/documents/shareInvites/$(incoming().inviteCode)).data.active == true
        && get(/databases/$(database)/documents/shareInvites/$(incoming().inviteCode)).data.expiresAt > request.time
        && get(/databases/$(database)/documents/shareInvites/$(incoming().inviteCode)).data.chantierId == incoming().chantierId
        && get(/databases/$(database)/documents/shareInvites/$(incoming().inviteCode)).data.ownerId == incoming().chantierOwnerId
        && (get(/databases/$(database)/documents/shareInvites/$(incoming().inviteCode)).data.usedByUid == ''
            || get(/databases/$(database)/documents/shareInvites/$(incoming().inviteCode)).data.usedByUid == request.auth.uid)
        && incoming().expiresAt == get(/databases/$(database)/documents/shareInvites/$(incoming().inviteCode)).data.expiresAt;

      allow update: if isVerifiedActive()
        && isValidShareDocId(shareId)
        && isValidChantierShare(incoming())
        && incoming().id == existing().id
        && incoming().chantierId == existing().chantierId
        && incoming().chantierOwnerId == existing().chantierOwnerId
        && incoming().readerUid == existing().readerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (existing().chantierOwnerId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['revoked', 'expiresAt', 'label', 'updatedAt']))
          || (existing().readerUid == request.auth.uid
              && incoming().revoked == false
              && exists(/databases/$(database)/documents/shareInvites/$(incoming().inviteCode))
              && get(/databases/$(database)/documents/shareInvites/$(incoming().inviteCode)).data.active == true
              && get(/databases/$(database)/documents/shareInvites/$(incoming().inviteCode)).data.expiresAt > request.time
              && get(/databases/$(database)/documents/shareInvites/$(incoming().inviteCode)).data.chantierId == incoming().chantierId
              && (get(/databases/$(database)/documents/shareInvites/$(incoming().inviteCode)).data.usedByUid == ''
                  || get(/databases/$(database)/documents/shareInvites/$(incoming().inviteCode)).data.usedByUid == request.auth.uid)
              && incoming().expiresAt == get(/databases/$(database)/documents/shareInvites/$(incoming().inviteCode)).data.expiresAt
              && incoming().diff(existing()).affectedKeys().hasOnly(['inviteCode', 'expiresAt', 'revoked', 'label', 'readerName', 'updatedAt']))
        );

      allow delete: if isVerifiedActive()
        && isValidShareDocId(shareId)
        && existing().chantierOwnerId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // 5. Private Chantiers & Daily Journals
    // -------------------------------------------------------------------------
    match /chantiers/{chantierId} {
      allow get: if isVerifiedActive()
        && isValidId(chantierId)
        && (resource == null || existing().ownerId == request.auth.uid || hasActiveShare(chantierId));

      allow list: if isVerifiedUser()
        && (resource.data.ownerId == request.auth.uid
          || request.auth.uid in resource.data.readerIds);

      allow create: if isVerifiedActive()
        && isValidId(chantierId)
        && isValidChantier(incoming())
        && incoming().id == chantierId
        && incoming().ownerId == request.auth.uid
        && incoming().visibility == 'private'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedActive()
        && isValidId(chantierId)
        && isValidChantier(incoming())
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (existing().ownerId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'readerIds', 'journalIds', 'numero', 'projet', 'entrepriseNom', 'entrepriseAdresse',
              'references', 'adresseChantier', 'horaireDebut', 'horaireFin',
              'preposeSurveillance', 'postes', 'updatedAt'
            ]))
          || (hasActiveShare(chantierId)
              && incoming().readerIds.hasAll(existing().readerIds)
              && incoming().readerIds.size() <= existing().readerIds.size() + 1
              && request.auth.uid in incoming().readerIds
              && incoming().diff(existing()).affectedKeys().hasOnly(['readerIds', 'updatedAt']))
        );

      allow delete: if isVerifiedActive()
        && isValidId(chantierId)
        && existing().ownerId == request.auth.uid;

      match /journaux/{journalId} {
        allow get: if isVerifiedActive()
          && isValidId(chantierId)
          && isValidId(journalId)
          && (get(/databases/$(database)/documents/chantiers/$(chantierId)).data.ownerId == request.auth.uid
              || hasActiveShare(chantierId));

        allow list: if isVerifiedUser()
          && (resource.data.chantierOwnerId == request.auth.uid
            || request.auth.uid in resource.data.chantierReaderIds);

        allow create: if isVerifiedActive()
          && isValidId(chantierId)
          && isValidId(journalId)
          && isValidJournal(incoming())
          && incoming().id == journalId
          && incoming().chantierId == chantierId
          && incoming().authorId == request.auth.uid
          && incoming().signatureControleur == null
          && incoming().signatureLecteur == null
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/chantiers/$(chantierId))
          && get(/databases/$(database)/documents/chantiers/$(chantierId)).data.ownerId == request.auth.uid
          && incoming().chantierOwnerId == get(/databases/$(database)/documents/chantiers/$(chantierId)).data.ownerId
          && incoming().chantierReaderIds == get(/databases/$(database)/documents/chantiers/$(chantierId)).data.readerIds;

        allow update: if isVerifiedActive()
          && isValidId(chantierId)
          && isValidId(journalId)
          && isValidJournal(incoming())
          && incoming().id == existing().id
          && incoming().chantierId == existing().chantierId
          && incoming().chantierOwnerId == existing().chantierOwnerId
          && incoming().authorId == existing().authorId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (existing().chantierOwnerId == request.auth.uid
              && existing().signatureControleur == null
              && existing().signatureLecteur == null
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'journalNum', 'date', 'horaireDebut', 'horaireFin',
                'tempMatin', 'tempApresMidi', 'etatAtmo', 'ouvriers',
                'travaux', 'materiel', 'materiaux', 'essais', 'evenements',
                'decisions', 'visites', 'sigEntrepreneur', 'updatedAt'
              ]))
            || (existing().chantierOwnerId == request.auth.uid
                && existing().status == 'completed'
                && existing().signatureControleur == null
                && incoming().signatureControleur != null
                && incoming().signatureControleur.signerUid == request.auth.uid
                && incoming().diff(existing()).affectedKeys().hasOnly(['signatureControleur', 'updatedAt']))
            || (hasActiveShare(chantierId)
                && existing().status == 'completed'
                && existing().signatureLecteur == null
                && incoming().signatureLecteur != null
                && incoming().signatureLecteur.signerUid == request.auth.uid
                && incoming().diff(existing()).affectedKeys().hasOnly(['signatureLecteur', 'updatedAt']))
            || (existing().chantierOwnerId == request.auth.uid
                && incoming().diff(existing()).affectedKeys().hasOnly(['chantierReaderIds', 'updatedAt']))
            || (hasActiveShare(chantierId)
                && incoming().chantierReaderIds.hasAll(existing().chantierReaderIds)
                && incoming().chantierReaderIds.size() <= existing().chantierReaderIds.size() + 1
                && request.auth.uid in incoming().chantierReaderIds
                && incoming().diff(existing()).affectedKeys().hasOnly(['chantierReaderIds', 'updatedAt']))
          );

        allow delete: if isVerifiedActive()
          && isValidId(chantierId)
          && isValidId(journalId)
          && get(/databases/$(database)/documents/chantiers/$(chantierId)).data.ownerId == request.auth.uid;
      }
    }
  }
}
